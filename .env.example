NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# memory | postgres
PERSISTENCE_DRIVER=postgres
DATABASE_URL=postgres://reservation:reservation@localhost:5432/reservation

# Comma-separated list of key:role:principalId. Roles: admin, client.
API_KEYS=dev-admin-key-change-me:admin:ops,dev-client-key-change-me:client:web-shop

HOLD_DEFAULT_TTL_SECONDS=600
HOLD_MAX_TTL_SECONDS=1800
HOLD_MAX_SEATS=10
HOLD_SWEEP_INTERVAL_MS=5000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_DELAY_MS=500
